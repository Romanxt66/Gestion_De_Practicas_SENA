# ─── Base de datos ──────────────────────────────────────
# Producción (Postgres):
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@postgres-db:5432/master_db
# Desarrollo local (SQLite):
# DATABASE_URL=sqlite:///flaskdb.sqlite   (se resuelve dentro de instance/)

# ─── Seguridad ──────────────────────────────────────────
# Clave de firma de sesiones. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si se deja vacía se persiste una en instance/.secret_key.
SECRET_KEY=
# Poner en True cuando el sitio se sirva por HTTPS
SESSION_COOKIE_SECURE=False
# Horas de duración de la sesión
SESSION_HOURS=8
# Tamaño máximo de archivo subido, en MB
MAX_UPLOAD_MB=15
# Zona horaria para las fechas de práctica ("hoy" se evalúa en esta zona)
APP_TIMEZONE=America/Bogota

# ─── Superusuario inicial (seed) ────────────────────────
ADMIN_EMAIL=admin@sena.edu.co
ADMIN_PASSWORD=
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=SENA
ADMIN_TIPO_DOCUMENTO=CC
ADMIN_NUMERO_DOCUMENTO=

# ─── Correo SMTP ────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10

# ─── Vincular cuentas de Google (opcional) ──────────────
# Credenciales del proyecto en Google Cloud. Sin ellas el apartado de
# Conexiones queda deshabilitado y todos los avisos salen por SMTP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la URI registrada en Google Cloud:
GOOGLE_REDIRECT_URI=https://practicassena.softlane.click/cuenta/google/callback
# Clave para cifrar los refresh tokens. Si se deja vacía se deriva de
# SECRET_KEY, y cambiar SECRET_KEY obligaría a reconectar las cuentas.
TOKEN_ENCRYPTION_KEY=

# ─── Arranque ───────────────────────────────────────────
# En 0, run.py no ejecuta create_all()/seed al importar (recomendado con
# varios workers; el esquema se gestiona con "flask db upgrade").
RUN_DB_INIT=1
